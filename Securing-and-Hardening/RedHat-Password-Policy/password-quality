#/etc/security/pwquality.conf

minlen = 8
difok = 3
ucredit = -1
lcredit = -1
dcredit = -1
ocredit = -1

#retry=3

#====================What each setting means==========================

#minlen = 8          Requires a password length of at least 10 characters.

#difok = 3             Requires a sufficient difference from the previous password according to the module's comparison rules.

#ucredit = -1          Requires at least one uppercase character.

#lcredit = -1          Requires at least one lowercase character.

#dcredit = -1          Requires at least one digit.

#ocredit = -1          Requires at least one non-alphanumeric character.